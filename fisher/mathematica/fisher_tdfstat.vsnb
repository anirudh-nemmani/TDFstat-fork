  {
   "kind": 2,
   "value": "dPhi = AssociationMap[Factor[D[Phi, #] /. modeRules] &, phasePars];\n\nshow[DisplayForm[pdBox[\"\\[CapitalPhi]\", parBox[#]]] & /@ phasePars, Values[dPhi]]",
