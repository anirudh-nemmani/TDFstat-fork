       "data": "<div class=\"wexpr\"><wgraph class=\"resizable\" style=\"width:759px;height:184px;\" aspect-ratio=\"0.2424\" tabIndex=\"-1\"><img class=\"invert-brightness\" src=\"data:image/png;base64,\" /></wgraph></div>",
