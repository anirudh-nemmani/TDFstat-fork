  {
   "kind": 1,
   "value": "### 2. Mode derivatives",
   "languageId": "markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "modeRules = {Derivative[1,0,0][aa][alpha,delta,i]    -> daDalpha,  Derivative[0,1,0][aa][alpha,delta,i]    -> daDdelta,\n             Derivative[1,0,0][bb][alpha,delta,i]    -> dbDalpha,  Derivative[0,1,0][bb][alpha,delta,i]    -> dbDdelta,\n             Derivative[1,0,0][shift][alpha,delta,i] -> dshDalpha, Derivative[0,1,0][shift][alpha,delta,i] -> dshDdelta,\n             aF -> a, bF -> b, sF -> sh};\n\ndModes = AssociationMap[\n   Function[p, Collect[#, {cosPhi, sinPhi}, Factor] & /@\n      ((D[modes, p] /. {Cos[Phi] -> cosPhi, Sin[Phi] -> sinPhi}) /. modeRules)],\n   phasePars];\n\nshow[labels[\"h\", f], dModes[f]]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wgraph class=\"resizable\" style=\"width:477px;height:172px;\" aspect-ratio=\"0.3607\" tabIndex=\"-1\"><img class=\"invert-brightness\" src=\"data:image/png;base64,\" /></wgraph></div>",
